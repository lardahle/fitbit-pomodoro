<svg>  
  <rect id="backgroundRect" x="0" y="0" fill="tomato" pointer-events="none" />
  
  <text id="clockText" x="50%" y="16%" text-anchor="middle" pointer-events="none">--:--</text>

  <text id="pomodoroText" x="50%" y="31%" text-anchor="middle" text-length="14" pointer-events="none">Pomodoro #1</text>
  <text id="stateText" x="50%" y="45%" text-anchor="middle" text-length="32" pointer-events="none">Start a Pomodoro</text>
  <text id="minuteText" x="50%" y="74%" text-anchor="middle" text-length="7" pointer-events="none">25</text>
  <text id="unitText" x="50%" y="88%" text-anchor="middle" pointer-events="none">min</text>

  <line x1="0" y1="50%" x2="100%" y2="50%" fill="white" stroke-width="2" />

  <!-- Full-screen tap target (combo-button widgets don't work on Sense 2) -->
  <rect id="tapZone" x="0" y="0" width="100%" height="100%" fill="black" opacity="0" pointer-events="fill" />
</svg>
